<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout_debrand" inherit_id="mail.mail_notification_layout">
        <!-- Replaces the Odoo promotional links in emails with the company's custom report footer while preserving mail_unfollow -->
        <xpath expr="//div[a[contains(@href, 'odoo.com')]]" position="replace">
            <div t-if="show_footer" style="color: #555555; font-size:11px;">
                <t t-if="company and company.report_footer">
                    <span t-out="company.report_footer"/>
                </t>
                <span t-if="show_unfollow" id="mail_unfollow">
                    | <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>
    
    <!-- Preserves mail_unfollow in mail_notification_light -->
    <template id="mail_notification_light_debrand" inherit_id="mail.mail_notification_light">
        <xpath expr="//td[a[contains(@href, 'odoo.com')]]" position="replace">
            <td align="center" style="min-width: 590px;">
                <div class="text-muted text-center mt-4">
                    <t t-if="company and company.report_footer">
                        <span t-out="company.report_footer"/>
                    </t>
                </div>
                <span t-if="show_unfollow" id="mail_unfollow">
                    | <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </td>
        </xpath>
    </template>

</odoo>
