<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('navbar-menu')]" position="inside">
            <div t-if="this.pos.config.module_pos_restaurant"
                 class="btn btn-light border-0 d-flex align-items-center px-4 nav-link-custom" 
                 t-att-class="{ 'active bg-view text-primary shadow-sm': this.pos.router.currentScreen() === 'BookingsScreen' }"
                 t-on-click="this.onBookingsClick">
                <i class="oi oi-filled me-2" data-icon="calendar_today" role="img" aria-label="Bookings" title="Bookings" />
                <span class="fw-bold">Bookings</span>
            </div>
        </xpath>
    </t>
</templates>
